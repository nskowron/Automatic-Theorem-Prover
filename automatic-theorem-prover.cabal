cabal-version: 3.0
name: automatic-theorem-prover
version: 0.1.0.0

library prover
  hs-source-dirs: src
  exposed-modules:
    Proposition
    FOL
    ACFp
    Node
    Prover
    Search
  default-extensions:
    AllowAmbiguousTypes
    DataKinds
    NoStarIsType
    QuantifiedConstraints
    TypeFamilies
    UndecidableInstances
  build-depends:
    base,
    data-debruijn,
    HList
  ghc-options:
    -Wno-missing-home-modules
  default-language: GHC2021

library test
  hs-source-dirs: test
  exposed-modules:
    AutomaticTests
  default-extensions:
    DataKinds
  build-depends:
    base,
    prover
  default-language: GHC2021
  
library examples
  hs-source-dirs: examples
  exposed-modules:
    Examples
  build-depends:
    base,
    prover
  default-language: GHC2021
